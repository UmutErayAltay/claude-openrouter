{
  "name": "claude-openrouter",
  "version": "0.1.0",
  "description": "Claude Code'a dokunmadan, OpenRouter uzerindeki istedigin modelleri /model menusune ekleyen yerel proxy",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UmutErayAltay/claude-openrouter.git"
  },
  "homepage": "https://github.com/UmutErayAltay/claude-openrouter#readme",
  "bugs": {
    "url": "https://github.com/UmutErayAltay/claude-openrouter/issues"
  },
  "keywords": [
    "claude-code",
